{
  "_comment": "글쓰기 규칙 위반 목록. harness/wording_check.py 가 읽는다. 유저가 지적한 말 하나가 여기 항목 하나가 된다 — 그것이 이 파일이 있는 이유다. `CLAUDE.md` 의 'How to write' 절과 '구어체를 쓰지 않는다' 절이 원본이고, source 열쇠가 그 항목이 어디서 왔는지 적는다. 금지어를 이름으로 부를 때는 백틱으로 감싼다 — 검사가 인라인 코드와 코드 블록을 빼고 본다.",
  "rules": [
    {
      "name": "재다",
      "kind": "구어체",
      "pattern": "(?<![가-힣])(?:잰다|잰|쟀[가-힣]*|재는[가-힣]*|재고|재서|재려[가-힣]*|재야|재자|재기|재면|재도)(?![가-힣])",
      "instead": "측정한다 / 판정한다 / 산출한다 (뜻에 맞는 것을 고른다)",
      "source": "CLAUDE.md 구어체 표"
    },
    {
      "name": "돌리다",
      "kind": "구어체",
      "pattern": "(?<![되뒤])(?:돌리[가-힣]*|돌린[가-힣]*|돌릴[가-힣]*|돌려(?![주준줄줍줬받])[가-힣]*|돌렸[가-힣]*)",
      "instead": "실행한다",
      "source": "CLAUDE.md 구어체 표. '되돌린다'는 이 규칙에 해당하지 않는다"
    },
    {
      "name": "잘리다",
      "kind": "구어체",
      "pattern": "(?:잘리[가-힣]*|잘린[가-힣]*|잘릴[가-힣]*|잘렸[가-힣]*)",
      "instead": "중단된다",
      "source": "CLAUDE.md 구어체 표"
    },
    {
      "name": "걸리다",
      "kind": "구어체",
      "pattern": "(?:예산|상한|제한|한도|총량)[에을를]?\\s*(?:걸리[가-힣]*|걸린[가-힣]*|걸릴[가-힣]*|걸렸[가-힣]*)",
      "instead": "제한에 도달한다 / 검출된다 / 차단된다 (뜻에 맞는 것을 고른다)",
      "source": "CLAUDE.md 구어체 표"
    },
    {
      "name": "집다",
      "kind": "구어체",
      "pattern": "(?:집는다|집었[가-힣]*|집는 것|집어서)",
      "instead": "이어받는다 / 착수한다",
      "source": "CLAUDE.md 구어체 표"
    },
    {
      "name": "벌 (수량 단위)",
      "kind": "구어체",
      "pattern": "(?:한|두|세|네|다섯|여섯|일곱|여덟|아홉|열|[0-9]+)\\s*벌(?![가-힣])",
      "instead": "회 / 개",
      "source": "CLAUDE.md 구어체 표"
    },
    {
      "name": "삼키다",
      "kind": "비유",
      "pattern": "(?:삼키[가-힣]*|삼킨[가-힣]*|삼킬[가-힣]*|삼켰[가-힣]*)",
      "instead": "항목을 한 세션에 다 채운다",
      "source": "CLAUDE.md 비유 금지"
    },
    {
      "name": "죽어 있다",
      "kind": "비유",
      "pattern": "죽(?:어 있|어있|었다|은 채)",
      "instead": "한 번도 실행되지 않는다",
      "source": "CLAUDE.md 비유 금지"
    },
    {
      "name": "접는 선",
      "kind": "만든 말",
      "pattern": "접는 선",
      "instead": "문장으로 풀어 쓴다",
      "source": "CLAUDE.md 비유 금지"
    },
    {
      "name": "함정 기회",
      "kind": "만든 말",
      "pattern": "함정 기회",
      "instead": "그 세션이 그 함정에 빠질 수 있는 자리를 지나갔는지",
      "source": "CLAUDE.md 만든 말 금지"
    },
    {
      "name": "말끝을 맞추다",
      "kind": "만든 말",
      "pattern": "말끝을 맞",
      "instead": "고른 쪽과 문서가 서로 맞는지",
      "source": "CLAUDE.md 만든 말 금지"
    },
    {
      "name": "눈금",
      "kind": "만든 말",
      "pattern": "눈금",
      "instead": "달성 항목 통과 수",
      "source": "CLAUDE.md 만든 말 금지"
    },
    {
      "name": "두 끝",
      "kind": "만든 말",
      "pattern": "두 끝",
      "instead": "시작 상태와 레퍼런스 해답",
      "source": "CLAUDE.md 만든 말 금지"
    },
    {
      "name": "갈리다",
      "kind": "구어체",
      "pattern": "(?:갈리[가-힣]*|갈린[가-힣]*|갈릴[가-힣]*|갈렸[가-힣]*)|안 갈리",
      "instead": "값이 서로 다르게 나온다 / 구분된다",
      "source": "유저 지적 2026-08-23, 2026-08-24 (두 번)"
    },
    {
      "name": "쌓이다 / 쌓다",
      "kind": "비유",
      "pattern": "쌓[가-힣]*",
      "instead": "뒤 항목의 완료 조건이 그 결정을 전제로 한다",
      "source": "유저 지적 2026-08-24"
    },
    {
      "name": "몰리다",
      "kind": "구어체",
      "pattern": "(?:몰리[가-힣]*|몰린[가-힣]*|몰릴[가-힣]*|몰렸[가-힣]*)",
      "instead": "한쪽 선택에 집중된다",
      "source": "유저 지적 2026-08-24"
    },
    {
      "name": "부딪히다",
      "kind": "비유",
      "pattern": "부딪[가-힣]*",
      "instead": "그 결정을 먼저 바꿔야 한다",
      "source": "유저 지적 2026-08-24"
    },
    {
      "name": "쳇바퀴",
      "kind": "비유",
      "pattern": "[챗쳇]바퀴",
      "instead": "같은 논의를 되풀이한다",
      "source": "유저 지적 2026-08-24"
    },
    {
      "name": "배터리 (지표 묶음)",
      "kind": "만든 말",
      "pattern": "배터리",
      "instead": "지표 스물일곱 종",
      "source": "유저 지적 2026-08-23"
    },
    {
      "name": "뽑아보다",
      "kind": "구어체",
      "pattern": "뽑아\\s*(?:보[가-힣]*|봤[가-힣]*)",
      "instead": "산출한다 / 추출한다",
      "source": "유저 지적 2026-08-23"
    },
    {
      "name": "대 보다 (지표를)",
      "kind": "구어체",
      "pattern": "(?:갖다 대|대 본다|대 봤)",
      "instead": "대조한다",
      "source": "유저 지적 2026-08-23"
    },
    {
      "name": "막히다",
      "kind": "비유",
      "pattern": "(?:완료 조건|항목|작업)[이가에서]{0,2}\\s*(?:막히[가-힣]*|막힌[가-힣]*|막혔[가-힣]*)",
      "instead": "완료 조건을 채울 수 없게 된다",
      "source": "유저 지적 2026-08-24. 도구·프록시가 '막혔다'는 정상 표현이라 구분되지 않는다 — 완료 조건과 항목에 쓴 것만 검출한다"
    }
  ]
}
